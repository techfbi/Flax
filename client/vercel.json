{
  "rewrites": [
    {
      "source": "/landingpage",
      "destination": "/landingpage.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://flax-148t.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ]
}